include README.md LICENSE CITATION.cff CHANGELOG.md CONTRIBUTING.md AGENTS.md mkdocs.yml references.bib
include requirements-reference.txt VALIDATION.md
include RELEASE_NOTES.md
include SECURITY.md
include NOTICE
recursive-include docs *.md *.js *.png *.svg *.json *.css *.txt *.ttf
recursive-include overrides *.html
recursive-include scripts *.py
recursive-include tests *.py
recursive-include results *.json
recursive-include results *.json.gz
exclude results/opportunities.json
recursive-include notebooks *.ipynb
recursive-include agent_eval *.py *.json *.md *.csv
prune results/local
recursive-include QML_utility *.py *.json *.md *.gz
include QML_utility/LICENSE
prune QML_utility/.cache
prune QML_utility/.pytest_cache
prune QML_utility/build
prune QML_utility/dist
prune QML_utility/results/local
prune QML_utility/qml_utility_workbench.egg-info
recursive-include reproductions *.json *.csv *.npy *.upstream *.md
